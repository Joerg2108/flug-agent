  "structures": [
    {"id": "nicht-nur-sondern", "regex": "(?i)\\bnicht\\s+nur\\b[^.!?\\n]{2,80}\\bsondern\\s+auch\\b", "name": "„Nicht nur X, sondern auch Y“", "fix": "In zwei Sätze teilen oder die schwächere Hälfte streichen."},
    {"id": "es-geht-nicht-um", "regex": "(?i)\\bes\\s+geht\\s+nicht\\s+(?:nur\\s+)?(?:um|darum)\\b[^.!?\\n]{2,80}[,.;–-]\\s*(?:es\\s+geht\\s+(?:um|darum)|sondern)\\b", "name": "„Es geht nicht um X. Es geht um Y.“", "fix": "Fang direkt mit Y an. Die Umkehrung ist das Erkennungsmerkmal."},
    {"id": "das-ist-nicht-x", "regex": "(?i)\\b(?:das|es)\\s+ist\\s+nicht\\s+(?:einfach\\s+|nur\\s+|bloß\\s+)?[^.!?\\n]{2,60}[,.]\\s*(?:das|es)\\s+ist\\b", "name": "„Das ist nicht X. Das ist Y.“", "fix": "Sag nur, was es ist. Die Aufbau-Hälfte streichen."},
    {"id": "rhetorische-zeile", "regex": "(?im)^\\s*(?:das\\s+ergebnis|der\\s+clou|der\\s+haken|die\\s+wahrheit|die\\s+lösung|der\\s+grund|die\\s+antwort|und\\s+jetzt|warum|das\\s+problem)\\?\\s*$", "name": "Rhetorische Ein-Wort-Frage als eigene Zeile", "fix": "Beantworte es im Satz, statt eine Enthüllung zu inszenieren."},
    {"id": "doppelpunkt-pointe", "regex": "(?i)\\b(?:spoiler|fakt\\s+ist|die\\s+wahrheit\\s+ist|die\\s+(?:bittere|unbequeme|harte)\\s+wahrheit(?:\\s+ist)?|und\\s+das\\s+beste|plot\\s*twist)\\s*:", "name": "Inszenierte Pointe mit Doppelpunkt („Spoiler:“, „Fakt ist:“)", "fix": "Sag es einfach. Die Ankündigung ist das Merkmal."},
    {"id": "was-ich-gelernt", "regex": "(?i)\\b(?:hier\\s+ist,?\\s+was\\s+ich\\s+gelernt\\s+habe|das\\s+habe\\s+ich\\s+(?:daraus\\s+)?gelernt\\s*:|meine\\s+(?:\\d+\\s+)?(?:learnings|erkenntnisse)\\s*:)", "name": "„Das habe ich gelernt:“", "fix": "Nenn die Erkenntnis. Lass die Ankündigung weg."},
    {"id": "kennst-du-das", "regex": "(?im)^\\s*(?:kennst\\s+du\\s+das|kennt\\s+ihr\\s+das|stell\\s+dir\\s+vor|stellt\\s+euch\\s+vor)\\b", "name": "KI-Einstieg „Kennst du das?“ / „Stell dir vor“", "fix": "Fang mit der konkreten Szene an, nicht mit der Einladung dazu."},
    {"id": "freue-mich-mitzuteilen", "regex": "(?i)\\bich\\s+(?:freue\\s+mich|bin\\s+stolz|bin\\s+begeistert|bin\\s+dankbar)\\b[^.!?\\n]{0,40}\\b(?:mitteilen|verkünden|bekanntgeben|bekannt\\s+geben|teilen)\\b", "name": "„Ich freue mich, mitteilen zu dürfen ...“", "fix": "Sag einfach, was passiert ist. Die Freude merkt man dann von selbst."},
    {"id": "dreierkette", "regex": "(?i)\\b[^\\W\\d_]+,\\s+[^\\W\\d_]+\\s+und\\s+[^\\W\\d_]+[.!]", "name": "Dreierkette („A, B und C.“)", "fix": "Zwei Dinge oder vier. Drei ist der Standard-Rhythmus des Modells."},
    {"id": "rakete", "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]", "name": "Rakete / Feuer / Glühbirne / Funkeln / Zielscheibe", "fix": "Höchstens ein Emoji, und nicht eins von diesen fünf."},
    {"id": "hashtag-wand", "regex": "(?:#[\\w-]+[ \\t]*){5,}", "name": "Hashtag-Wand (5+)", "fix": "Drei Hashtags reichen. Die Wand belohnt LinkedIn nicht mehr."},
    {"id": "ki-selbstbezug", "regex": "(?i)\\bals\\s+(?:eine\\s+)?(?:ki|künstliche\\s+intelligenz|sprachmodell)\\b", "name": "KI-Selbstbezug", "fix": "Satz löschen."},
    {"id": "aufsatz-schluss", "regex": "(?im)^\\s*(?:fazit|zusammenfassend|abschließend|kurzum|alles\\s+in\\s+allem|zum\\s+schluss)\\b", "name": "Aufsatz-Schluss („Fazit:“, „Zusammenfassend“)", "fix": "Ein Post braucht keinen Schlussabsatz."},
    {"id": "engagement-koeder", "regex": "(?im)(?:was\\s+(?:denkt|meint|sagt)\\s+ihr(?:\\s+dazu)?\\?|wie\\s+seht\\s+ihr\\s+das\\?|seht\\s+ihr\\s+das\\s+(?:auch\\s+)?so\\?|wer\\s+kennt\\s+das\\?|wer\\s+noch\\?|stimmt\\s+ihr\\s+zu\\?|was\\s+denkst\\s+du\\?|wie\\s+siehst\\s+du\\s+das\\?|was\\s+meinst\\s+du\\?)\\s*$", "name": "Reflex-Engagement-Köder („Was denkt ihr?“)", "fix": "Stell eine Frage, die nur du stellen kannst - zu genau dem, was drüber steht."}
  ]
}
